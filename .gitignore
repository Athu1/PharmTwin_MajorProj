# ==========================================
# 1. Secrets & Credentials (CRITICAL)
# ==========================================
.env
.env.local
*.pem
*.key

# ==========================================
# 2. Large Data & Model Artifacts
# (Prevents hitting GitHub's 100 MB file limit)
# ==========================================
# Raw sponsor POS data (NDA / Privacy) — real exports go in Agent/data/raw/sponsor/
Agent/data/raw/

# Processed outputs (regenerate via scripts). Agent/data/originals/ and
# Agent/data/processed/models_step3/ stay TRACKED on purpose (frozen demo baseline).
Agent/data/processed/*.csv
Agent/data/processed/*.parquet
Agent/data/processed/*.json

